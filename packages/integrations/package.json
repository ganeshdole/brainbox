{
  "name": "@ganeshdole/brainbox-integrations",
  "version": "0.3.0",
  "description": "Send a Brainbox report to GitHub issues or Azure DevOps work items. A Destination takes a Ticket and returns where it landed; fetch and WebCrypto only.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://www.brainbox.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganeshdole/brainbox.git",
    "directory": "packages/integrations"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ganeshdole/brainbox-shared": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.60.1",
    "vitest": "catalog:"
  }
}
