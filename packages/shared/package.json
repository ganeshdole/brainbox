{
  "name": "@brainbox/shared",
  "version": "0.1.0",
  "description": "Brainbox wire types, shared by the widget, the SDK packages and the backend. Pure types, no runtime.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://www.brainbox.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganeshdole/brainbox.git",
    "directory": "packages/shared"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.60.1"
  }
}
