{
  "name": "@ganeshdole/brainbox-replay",
  "version": "0.3.0",
  "description": "Play back a Brainbox session recording in React: the widget's rrweb log with its voice note lined up, themeable with plain CSS.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://brainbox.ganeshdole.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganeshdole/brainbox.git",
    "directory": "packages/replay"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rrweb/replay": "2.1.0",
    "lucide-react": "^1.17.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "catalog:",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.60.1",
    "vitest": "catalog:"
  }
}
