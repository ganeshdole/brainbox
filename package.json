{
  "name": "brainbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm -r lint && pnpm -r typecheck && pnpm -r test && pnpm -r build",
    "release": "pnpm verify && pnpm -r publish",
    "dev:marketing": "pnpm -F brainbox-landing dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
