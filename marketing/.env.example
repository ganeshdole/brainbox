# Backend API base URL for the "Reserve early access" form.
# Defaults to https://app.brainbox.ganeshdole.com when unset. Point at a local backend
# during development:
VITE_API_BASE_URL=http://localhost:8787

# Demo widget config (the landing page runs the real Brainbox widget). These
# override the built-in demo defaults for testing against a seeded backend.
# VITE_DEMO_PROJECT_KEY=pk_test_local
# VITE_DEMO_ENDPOINT=http://localhost:8787/ingest

# In production the page loads https://app.brainbox.ganeshdole.com/widget.js - the same tag
# customers paste - so widget releases land here via the box deploy with no
# marketing rebuild. Point at the local copy (`pnpm dev` writes public/widget.js)
# to develop against a widget you built yourself:
# VITE_DEMO_WIDGET_SRC=/widget.js
