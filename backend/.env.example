# Auth.js - generate with: openssl rand -base64 33
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID, Web app)
GOOGLE_ID=
GOOGLE_SECRET=
# Where data lives: "postgres" (default), "convex", or "custom" (an entry passes
# its own to setStore()). See docs/self-hosting.md.
DATABASE_DRIVER=postgres
# Postgres (matches docker-compose.yml; only needed when DATABASE_DRIVER=postgres)
DATABASE_URL=postgres://brainbox:brainbox@localhost:5432/brainbox
# Convex (only needed when DATABASE_DRIVER or STORAGE_DRIVER is convex). The
# secret must match BRAINBOX_SERVER_SECRET on the Convex deployment.
CONVEX_URL=
BRAINBOX_SERVER_SECRET=
# Base URL of the Auth.js mount (used for OAuth callbacks)
AUTH_URL=http://localhost:8787/api/auth
# Dashboard origin allowed by CORS (the SPA, step 5)
DASHBOARD_ORIGIN=http://localhost:5173
# Origins allowed to POST /waitlist (the marketing site), comma-separated.
# Defaults to brainbox.sh + www + localhost dev ports when unset.
MARKETING_ORIGIN=https://brainbox.sh,https://www.brainbox.sh,http://localhost:5173,http://localhost:4173
# Port the API listens on
PORT=8787
# Public base URL of this API (used to build local file URLs)
PUBLIC_API_URL=http://localhost:8787
# Object storage: "local" (writes backend/.storage/, development only), "s3",
# "r2", "convex", or "custom" (an entry passes its own to setStorage())
STORAGE_DRIVER=local
# Any S3-compatible store (only needed when STORAGE_DRIVER=s3). Leave
# S3_ENDPOINT empty for AWS itself, and the keys empty to use an IAM role.
# S3_FORCE_PATH_STYLE=true for MinIO and Supabase Storage.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
# Cloudflare R2 (only needed when STORAGE_DRIVER=r2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Transactional email. "console" logs the message (dev, no network); "resend"
# sends via the Resend API (needs RESEND_API_KEY + a verified sending domain).
EMAIL_DRIVER=console
RESEND_API_KEY=
# From address - must be on a Resend-verified domain once EMAIL_DRIVER=resend.
# mail.brainbox.sh is the verified sending domain (the apex brainbox.sh is not).
EMAIL_FROM=Brainbox <hello@mail.brainbox.sh>
# Optional Reply-To on outbound email.
EMAIL_REPLY_TO=
# What the sign-in email carries: "link" (default), "code" (a 6-digit code typed
# on the login page) or "both". "off" turns email sign-in off: Google only.
AUTH_EMAIL_MODE=link
# Who may sign in, comma-separated domains (e.g. "acme.com,acme.io"). Empty =
# anyone. When set, other addresses get in only with a Team invite.
AUTH_ALLOWED_EMAIL_DOMAINS=
# Voice-note transcription: "groq" or "openai"; empty = off.
# TRANSCRIPTION_MODEL overrides the provider default (whisper-large-v3-turbo /
# gpt-4o-mini-transcribe); only the selected provider's key is needed.
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
# --- Dodo Payments ---
# One key plus one environment flag, not separate test/live keys: a key only
# works against its own host, so a mismatch fails loudly on the first call
# instead of silently charging real cards from a dev box.
DODO_API_KEY=
# "test_mode" (default) or "live_mode".
DODO_ENVIRONMENT=test_mode
# Signing secret from Dashboard → Developer → Webhooks. Without it the webhook
# route rejects everything - refusing unverifiable payment events is the only
# safe default.
DODO_WEBHOOK_SECRET=
# Product ids are per-environment (the live catalogue has different ids from
# test), so they are configuration, not constants. Checkout 503s until all four
# are set.
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_ANNUAL=
DODO_PRODUCT_BUSINESS_MONTHLY=
DODO_PRODUCT_BUSINESS_ANNUAL=
# --- GitHub App (routes reports into customers' repos) ---
# All optional; unset = the GitHub section of project settings is unavailable.
# Private key: PKCS#8 PEM, base64-encoded:
#   openssl pkcs8 -topk8 -nocrypt -in app.pem | base64
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# The app's OAuth client (same settings page). Enable "Request user
# authorization (OAuth) during installation" and set the Callback URL to
# <PUBLIC_API_URL>/api/integrations/github/callback.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Accounts allowed past the paywall without paying (ours), comma-separated.
# In env rather than the codebase so access can change without a deploy.
BILLING_EXEMPT_EMAILS=
# "true" turns the paywall off: every account is treated as exempt.
BILLING_DISABLED=
