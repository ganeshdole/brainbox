{
  "name": "@ganeshdole/brainbox-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/azure.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "fake:ado": "tsx scripts/fake-azure-devops.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.5",
    "@ai-sdk/openai": "^4.0.7",
    "@auth/core": "0.41.2",
    "@auth/drizzle-adapter": "^1.11.2",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@azure/functions": "^4.16.5",
    "@ganeshdole/brainbox-integrations": "workspace:*",
    "@ganeshdole/brainbox-server": "workspace:*",
    "@ganeshdole/brainbox-shared": "workspace:*",
    "@hono/auth-js": "^1.1.1",
    "@hono/node-server": "^2.0.6",
    "ai": "^7.0.15",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.128",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "postgres": "^3.4.9",
    "resend": "^6.17.2",
    "sharp": "^0.35.2",
    "standardwebhooks": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "typescript-eslint": "^8.60.1",
    "vitest": "catalog:"
  }
}
